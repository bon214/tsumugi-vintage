# Exact versions, always. A range in package.json means the registry decides
# what ships; `npm i <pkg>` writing a caret is how that happens by accident.
save-exact=true

# Reproducible installs in CI: fail if the lockfile and package.json disagree
# rather than silently resolving something new.
engine-strict=true

# No install scripts from transitive dependencies. esbuild's own postinstall is
# needed, so allow it explicitly rather than allowing everything.
# ignore-scripts=true
